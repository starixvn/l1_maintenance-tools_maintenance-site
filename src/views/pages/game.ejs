<div class="container">
    <h1>
        <%= gameTitle %>
    </h1>

    <div class="game-container">
        <div class="game-controls">
            <button id="startGame" class="btn">Start Game</button>
            <button id="resetGame" class="btn">Reset</button>
        </div>

        <div id="gameArea" class="game-area">
            <!-- Game content will be added here -->
        </div>

        <div id="gameScore" class="game-score">
            Score: <span>0</span>
        </div>
    </div>
</div>